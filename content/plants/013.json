            "blocks": [
                {
                    "kind": "paragraph",
                    "text": "《芣苢》、《黍离》、《扬之水》、《椒聊》、《葛生》、《葛生》、《黄鸟》"
                }
            ]
        },
        {
            "id": "s2",
            "title": "古代记载",
            "blocks": [
                {
                    "kind": "source",
                    "text": "《〈毛诗传〉笺》"
                },
                {
                    "kind": "paragraph",
                    "text": "楚，杂薪之中尤翘翘者。（郑玄笺释《芣苢》）"
                },
                {
                    "kind": "source",
                    "text": "《毛诗正义》"
                },
                {
                    "kind": "paragraph",
                    "text": "楚亦木名，故《学记》注以楚为荆。（《毛诗正义》疏《芣苢》）"
                },
                {
                    "kind": "paragraph",
                    "text": "楚木。（《毛诗正义》疏《葛生》）"
                },
                {
                    "kind": "source",
                    "text": "《诗集传》"
                },
                {
                    "kind": "paragraph",
                    "text": "楚，木名。荆屬。（《诗集传》集注《芣苢》）"
                },
                {
                    "kind": "paragraph",
                    "text": "楚、木也。（《诗集传》集注《黍离》、《黄鸟》）"
                }
            ]
        },
        {
            "id": "s3",
            "title": "当代记载",
            "blocks": [
                {
                    "kind": "source",
                    "text": "《中国植物志》"
                },
                {
                    "kind": "paragraph",
                    "text": "（是否为植物尚无定论，有人认为是一种类荆的灌木。）"
                }
            ]
        }
    ],
